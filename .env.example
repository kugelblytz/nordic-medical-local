ASR_MODEL=large-v3-turbo
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=en

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT=35
OLLAMA_WARMUP_TIMEOUT=180
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192

# "segment" is the safer default for the supplied gold spans.
# Try "word" on validation if it scores better.
EVIDENCE_MODE=segment
EVIDENCE_PAD_SECONDS=0.20

WARMUP_ON_START=true

HOST=0.0.0.0
PORT=9054
