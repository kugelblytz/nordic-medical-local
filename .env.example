ASR_MODEL=large-v3-turbo
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=en

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:27b
OLLAMA_TIMEOUT=35
OLLAMA_WARMUP_TIMEOUT=180
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192

# "segment" is the safer default for the supplied gold spans.
# Try "word" on validation if it scores better.
EVIDENCE_MODE=segment
EVIDENCE_PAD_SECONDS=0.20
EVIDENCE_QUOTE_PAD_SECONDS=0.12
# Primary word-boundary path starts with zero padding for a clean A/B.
EVIDENCE_WORD_PAD_SECONDS=0.00
EVIDENCE_MAX_WORD_SPAN=80

# Optional second-pass evidence-only refinement. It cannot change TRUE/FALSE.
EVIDENCE_REFINEMENT_ENABLED=false
EVIDENCE_REFINEMENT_TIMEOUT=90
EVIDENCE_REFINEMENT_NUM_PREDICT=900

# Optional research logging. Keep disabled for normal competition runs.
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_DIR=.diagnostics/word-boundary-v1

WARMUP_ON_START=true

HOST=0.0.0.0
PORT=9054
