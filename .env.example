ASR_MODEL=large-v3-turbo
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=en

# Safe default. Set to "openai" only for the development evaluator experiment.
LLM_PROVIDER=ollama

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:27b
OLLAMA_TIMEOUT=35
OLLAMA_WARMUP_TIMEOUT=180
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192

# Never commit a real key. Export OPENAI_API_KEY in the shell instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING=high
OPENAI_TIMEOUT=50
OPENAI_MAX_OUTPUT_TOKENS=8000

EVIDENCE_MODE=segment
EVIDENCE_PAD_SECONDS=0.20
EVIDENCE_QUOTE_PAD_SECONDS=0.12

WARMUP_ON_START=true

HOST=0.0.0.0
PORT=9054
